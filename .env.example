# WeChat bridge credentials — obtain with:
#   docker compose run --rm weixin setup
WEIXIN_ACCOUNT_ID=
WEIXIN_TOKEN=
WEIXIN_BASE_URL=

# Model credentials (DeepSeek official adapter, same as the Web UI).
DEEPSEEK_API_KEY=

# Optional overrides.
# WEIXIN_DM_POLICY=open            # open | allowlist
# WEIXIN_ALLOWED_USERS=user1,user2
# WEIXIN_PROVIDER=
# WEIXIN_MODEL=
