# ===== DeepSeek 模型 API Key（必填）=====
# 获取地址：https://platform.deepseek.com  →  API Keys → 创建
# 填到这里即可，微信 bot 和 headless 模式都会用它，无需打开网页界面。
DEEPSEEK_API_KEY=

# ===== 微信凭据（第一次运行时用 `docker compose run --rm weixin setup` 扫码获得）=====
WEIXIN_ACCOUNT_ID=
WEIXIN_TOKEN=
WEIXIN_BASE_URL=

# ===== 可选：微信访问控制 =====
# WEIXIN_DM_POLICY=open              # open=任何人都能私聊 | allowlist=仅白名单
# WEIXIN_ALLOWED_USERS=user1,user2   # DM_POLICY=allowlist 时生效，逗号分隔

# ===== 可选：模型覆盖 =====
# WEIXIN_PROVIDER=                   # 留空则继承 dsh 默认（deepseek-official）
# WEIXIN_MODEL=                      # 留空则继承 dsh 默认（deepseek-v4-flash）
